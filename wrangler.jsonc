{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "octaloop",
  "account_id": "4ec1f0e100565db185c280ea8a149600",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": {
    "command": "echo 'Using pre-built _site'"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.js",
  "d1_databases": [{ "binding": "PORTAL_DB", "database_name": "octaloop-portal", "database_id": "5db3cf23-b7a1-4c87-a532-027dc7dc57f7" }],
  "kv_namespaces": [{ "binding": "PORTAL_FILES", "id": "43620d461ce0410e8918118f25a35f9b" }],
  "routes": [
    { "pattern": "octaloop.com/*", "zone_name": "octaloop.com" },
    { "pattern": "www.octaloop.com/*", "zone_name": "octaloop.com" },
    { "pattern": "metamorphosis.octaloop.com/*", "zone_name": "octaloop.com" },
    { "pattern": "metamorphosis24.octaloop.com/*", "zone_name": "octaloop.com" },
    { "pattern": "test.metamorphosis.octaloop.com/*", "zone_name": "octaloop.com" },
    { "pattern": "g7.octaloop.com/*", "zone_name": "octaloop.com" }
  ]
}
